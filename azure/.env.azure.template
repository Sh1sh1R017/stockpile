# Azure Cloud Environment Configuration Template
# Copy this or set these in Azure Container Apps Secret / Environment Variables

# ==========================================
# 1. AI & LLM Models
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
WHISPER_MODEL=base

# ==========================================
# 2. Google Drive Cloud Sync
# ==========================================
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_DRIVE_INPUT_FOLDER_ID=your_drive_input_folder_id
GOOGLE_DRIVE_OUTPUT_FOLDER_ID=your_drive_output_folder_id

# Headless Refresh Token (Optional: for 24/7 cloud sync without browser prompts)
GOOGLE_DRIVE_REFRESH_TOKEN=

# ==========================================
# 3. Azure Cloud Storage & Settings
# ==========================================
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=broll-media
PORT=8000
FRONTEND_PORT=3000
BACKEND_API_URL=http://127.0.0.1:8000

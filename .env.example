# Dedicated high-reasoning B-roll model. It listens to source audio for tone and emotion.
GEMINI_BROLL_SUPER_MODEL=gemini-2.5-pro

# stockpile config
# copy this file to .env and fill in your values

# required API key
GEMINI_API_KEY=

# input sources (local required)
LOCAL_INPUT_FOLDER=input
GOOGLE_DRIVE_INPUT_FOLDER_ID=

# output destinations (local required)
LOCAL_OUTPUT_FOLDER=output
GOOGLE_DRIVE_OUTPUT_FOLDER_ID=

# email notifications (optional)
NOTIFICATION_EMAIL=

# models
WHISPER_MODEL=base
GEMINI_MODEL=gemma-3-27b-it # <-- completely free

# google API (required if using Google Drive and/or you want email notifications)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# processing settings
MAX_VIDEOS_PER_PHRASE=3
MAX_VIDEO_DURATION_SECONDS=900
MAX_VIDEO_SIZE_MB=80
MAX_CLIP_DURATION_SECONDS=3

# Pexels Video API (Optional - free key from pexels.com for royalty-free vertical stock B-roll)
PEXELS_API_KEY=

# OpenShorts long-video clipping service (optional)
# Self-host example: http://openshorts:8000 when both services share Docker Compose
OPENSHORTS_API_URL=
OPENSHORTS_API_KEY=

# Optional checkout of nexu-io/motion-anything for motion recipe discovery
MOTION_ANYTHING_DIR=motion-anything

# Comma-separated frontend origins allowed by the FastAPI API.
STOCKPILE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional absolute font path for FFmpeg drawtext (Windows paths are escaped automatically).
STOCKPILE_FONT_PATH=
